    "topics" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#d9d9d9"><B>TOPICS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="topic_id" BGCOLOR="#ffffff"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><B>topic_id</B><FONT COLOR='#555555'> *</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="topic_name" BGCOLOR="#ffffff"><FONT POINT-SIZE="8">UQ</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">topic_name<FONT COLOR='#555555'> *</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">character varying(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="description" BGCOLOR="#ffffff"> </TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">description</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">text</FONT></TD></TR></TABLE>>];
    "paper_topics" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#d9d9d9"><B>PAPER_TOPICS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="paper_id" BGCOLOR="#ffffff"><FONT POINT-SIZE="8">PK,FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><B>paper_id</B><FONT COLOR='#555555'> *</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="topic_id" BGCOLOR="#ffffff"><FONT POINT-SIZE="8">PK,FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><B>topic_id</B><FONT COLOR='#555555'> *</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">bigint</FONT></TD></TR></TABLE>>];
