digraph scholarly {
  graph [rankdir=LR, splines=spline, overlap=false, nodesep=0.45, ranksep=1.5, fontname="Helvetica", labelloc="t", fontsize=22,  label="Scholarly  -  Full Entity Relationship Diagram  (20 tables, 26 foreign keys)\n "];
  node [shape=plaintext, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9, color="#000000", labeldistance=1.8, labelangle=20];
  subgraph cluster_0 {
    label="Core Platform / Identity"; fontsize=15; fontcolor="#000000";
    style="dashed"; color="#000000"; penwidth=1.1; margin=18;
    "people" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#d9d9d9"><B>PEOPLE</B></TD></TR><TR><TD ALIGN="LEFT" PORT="person_id" BGCOLOR="#ffffff"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><B>person_id</B><FONT COLOR='#555555'> *</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="full_name" BGCOLOR="#ffffff"> </TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">full_name<FONT COLOR='#555555'> *</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">character varying(200)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="email" BGCOLOR="#ffffff"><FONT POINT-SIZE="8">UQ</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">email<FONT COLOR='#555555'> *</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">citext</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at" BGCOLOR="#ffffff"> </TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">created_at<FONT COLOR='#555555'> *</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">timestamp with time zone</FONT></TD></TR></TABLE>>];
    "user_accounts" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#d9d9d9"><B>USER_ACCOUNTS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="account_id" BGCOLOR="#ffffff"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><B>account_id</B><FONT COLOR='#555555'> *</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="person_id" BGCOLOR="#ffffff"><FONT POINT-SIZE="8">FK,UQ</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">person_id<FONT COLOR='#555555'> *</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="password_hash" BGCOLOR="#ffffff"> </TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">password_hash<FONT COLOR='#555555'> *</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="system_role" BGCOLOR="#ffffff"> </TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">system_role<FONT COLOR='#555555'> *</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">character varying(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="account_status" BGCOLOR="#ffffff"> </TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">account_status<FONT COLOR='#555555'> *</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">character varying(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at" BGCOLOR="#ffffff"> </TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">created_at<FONT COLOR='#555555'> *</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">timestamp with time zone</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="last_login_at" BGCOLOR="#ffffff"> </TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">last_login_at</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">timestamp with time zone</FONT></TD></TR></TABLE>>];
    "author_profiles" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#d9d9d9"><B>AUTHOR_PROFILES</B></TD></TR><TR><TD ALIGN="LEFT" PORT="person_id" BGCOLOR="#ffffff"><FONT POINT-SIZE="8">PK,FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><B>person_id</B><FONT COLOR='#555555'> *</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="profile_status" BGCOLOR="#ffffff"> </TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">profile_status<FONT COLOR='#555555'> *</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">character varying(20)</FONT></TD></TR></TABLE>>];
    "reviewer_profiles" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#d9d9d9"><B>REVIEWER_PROFILES</B></TD></TR><TR><TD ALIGN="LEFT" PORT="person_id" BGCOLOR="#ffffff"><FONT POINT-SIZE="8">PK,FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><B>person_id</B><FONT COLOR='#555555'> *</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="bio" BGCOLOR="#ffffff"> </TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">bio</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="research_keywords" BGCOLOR="#ffffff"> </TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">research_keywords</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="reviewer_status" BGCOLOR="#ffffff"> </TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">reviewer_status<FONT COLOR='#555555'> *</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">character varying(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at" BGCOLOR="#ffffff"> </TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">created_at<FONT COLOR='#555555'> *</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">timestamp with time zone</FONT></TD></TR></TABLE>>];
    "affiliations" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#d9d9d9"><B>AFFILIATIONS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="affiliation_id" BGCOLOR="#ffffff"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><B>affiliation_id</B><FONT COLOR='#555555'> *</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="institution_name" BGCOLOR="#ffffff"> </TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">institution_name<FONT COLOR='#555555'> *</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">character varying(250)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="institution_domain" BGCOLOR="#ffffff"> </TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">institution_domain</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">character varying(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="country_code" BGCOLOR="#ffffff"> </TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">country_code</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">character(2)</FONT></TD></TR></TABLE>>];
    "person_affiliations" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#d9d9d9"><B>PERSON_AFFILIATIONS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="person_id" BGCOLOR="#ffffff"><FONT POINT-SIZE="8">PK,FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><B>person_id</B><FONT COLOR='#555555'> *</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="affiliation_id" BGCOLOR="#ffffff"><FONT POINT-SIZE="8">PK,FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><B>affiliation_id</B><FONT COLOR='#555555'> *</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="start_date" BGCOLOR="#ffffff"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><B>start_date</B><FONT COLOR='#555555'> *</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="end_date" BGCOLOR="#ffffff"> </TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">end_date</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">date</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_1 {
    label="Core Platform / Conferences &amp; Submissions"; fontsize=15; fontcolor="#000000";
    style="dashed"; color="#000000"; penwidth=1.1; margin=18;
    "conferences" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#d9d9d9"><B>CONFERENCES</B></TD></TR><TR><TD ALIGN="LEFT" PORT="conference_id" BGCOLOR="#ffffff"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><B>conference_id</B><FONT COLOR='#555555'> *</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name" BGCOLOR="#ffffff"> </TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">name<FONT COLOR='#555555'> *</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">character varying(200)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="acronym" BGCOLOR="#ffffff"> </TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">acronym<FONT COLOR='#555555'> *</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">character varying(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="year" BGCOLOR="#ffffff"> </TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">year<FONT COLOR='#555555'> *</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="description" BGCOLOR="#ffffff"> </TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">description</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="submission_open_at" BGCOLOR="#ffffff"> </TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">submission_open_at<FONT COLOR='#555555'> *</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">timestamp with time zone</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="submission_close_at" BGCOLOR="#ffffff"> </TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">submission_close_at<FONT COLOR='#555555'> *</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">timestamp with time zone</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="review_deadline" BGCOLOR="#ffffff"> </TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">review_deadline<FONT COLOR='#555555'> *</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">timestamp with time zone</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status" BGCOLOR="#ffffff"> </TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">status<FONT COLOR='#555555'> *</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">character varying(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at" BGCOLOR="#ffffff"> </TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">created_at<FONT COLOR='#555555'> *</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">timestamp with time zone</FONT></TD></TR></TABLE>>];
