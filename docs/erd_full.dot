    "papers" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#d9d9d9"><B>PAPERS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="paper_id" BGCOLOR="#ffffff"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><B>paper_id</B><FONT COLOR='#555555'> *</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="conference_id" BGCOLOR="#ffffff"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">conference_id<FONT COLOR='#555555'> *</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="title" BGCOLOR="#ffffff"> </TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">title<FONT COLOR='#555555'> *</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">character varying(300)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="abstract" BGCOLOR="#ffffff"> </TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">abstract<FONT COLOR='#555555'> *</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="submission_status" BGCOLOR="#ffffff"> </TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">submission_status<FONT COLOR='#555555'> *</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">character varying(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="submitted_at" BGCOLOR="#ffffff"> </TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">submitted_at<FONT COLOR='#555555'> *</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">timestamp with time zone</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_by_person_id" BGCOLOR="#ffffff"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">created_by_person_id<FONT COLOR='#555555'> *</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at" BGCOLOR="#ffffff"> </TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">updated_at<FONT COLOR='#555555'> *</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">timestamp with time zone</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="search_vector" BGCOLOR="#ffffff"> </TD><TD ALIGN="LEFT" BGCOLOR="#ffffff">search_vector</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555" POINT-SIZE="8">tsvector</FONT></TD></TR></TABLE>>];
