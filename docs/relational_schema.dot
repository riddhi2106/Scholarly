digraph scholarly_relational {
  graph [rankdir=TB, splines=spline, nodesep=0.40, ranksep=0.55, outputorder=edgesfirst, fontname="Helvetica", labelloc="t", fontsize=24,  label="Scholarly  -  Relational Schema Diagram  (20 relations, 26 foreign keys)\nPrimary key attributes are underlined. An arrow runs from each foreign key attribute to the primary key attribute it references.\n "];
  node [shape=plaintext, fontname="Helvetica", fontsize=11];
  edge [color="#000000", penwidth=1.0, arrowsize=0.7];
  "people" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="4" ALIGN="LEFT" BORDER="0" CELLPADDING="2"><FONT POINT-SIZE="13"><B>PEOPLE</B></FONT></TD></TR><TR><TD PORT="person_id" ALIGN="CENTER" BGCOLOR="#ffffff"><U>person_id</U></TD><TD PORT="full_name" ALIGN="CENTER" BGCOLOR="#ffffff">full_name</TD><TD PORT="email" ALIGN="CENTER" BGCOLOR="#ffffff">email</TD><TD PORT="created_at" ALIGN="CENTER" BGCOLOR="#ffffff">created_at</TD></TR></TABLE>>];
  "user_accounts" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="7" ALIGN="LEFT" BORDER="0" CELLPADDING="2"><FONT POINT-SIZE="13"><B>USER_ACCOUNTS</B></FONT></TD></TR><TR><TD PORT="account_id" ALIGN="CENTER" BGCOLOR="#ffffff"><U>account_id</U></TD><TD PORT="person_id" ALIGN="CENTER" BGCOLOR="#ffffff">person_id</TD><TD PORT="password_hash" ALIGN="CENTER" BGCOLOR="#ffffff">password_hash</TD><TD PORT="system_role" ALIGN="CENTER" BGCOLOR="#ffffff">system_role</TD><TD PORT="account_status" ALIGN="CENTER" BGCOLOR="#ffffff">account_status</TD><TD PORT="created_at" ALIGN="CENTER" BGCOLOR="#ffffff">created_at</TD><TD PORT="last_login_at" ALIGN="CENTER" BGCOLOR="#ffffff">last_login_at</TD></TR></TABLE>>];
  "author_profiles" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="2" ALIGN="LEFT" BORDER="0" CELLPADDING="2"><FONT POINT-SIZE="13"><B>AUTHOR_PROFILES</B></FONT></TD></TR><TR><TD PORT="person_id" ALIGN="CENTER" BGCOLOR="#ffffff"><U>person_id</U></TD><TD PORT="profile_status" ALIGN="CENTER" BGCOLOR="#ffffff">profile_status</TD></TR></TABLE>>];
  "reviewer_profiles" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="5" ALIGN="LEFT" BORDER="0" CELLPADDING="2"><FONT POINT-SIZE="13"><B>REVIEWER_PROFILES</B></FONT></TD></TR><TR><TD PORT="person_id" ALIGN="CENTER" BGCOLOR="#ffffff"><U>person_id</U></TD><TD PORT="bio" ALIGN="CENTER" BGCOLOR="#ffffff">bio</TD><TD PORT="research_keywords" ALIGN="CENTER" BGCOLOR="#ffffff">research_keywords</TD><TD PORT="reviewer_status" ALIGN="CENTER" BGCOLOR="#ffffff">reviewer_status</TD><TD PORT="created_at" ALIGN="CENTER" BGCOLOR="#ffffff">created_at</TD></TR></TABLE>>];
  "affiliations" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="4" ALIGN="LEFT" BORDER="0" CELLPADDING="2"><FONT POINT-SIZE="13"><B>AFFILIATIONS</B></FONT></TD></TR><TR><TD PORT="affiliation_id" ALIGN="CENTER" BGCOLOR="#ffffff"><U>affiliation_id</U></TD><TD PORT="institution_name" ALIGN="CENTER" BGCOLOR="#ffffff">institution_name</TD><TD PORT="institution_domain" ALIGN="CENTER" BGCOLOR="#ffffff">institution_domain</TD><TD PORT="country_code" ALIGN="CENTER" BGCOLOR="#ffffff">country_code</TD></TR></TABLE>>];
  "person_affiliations" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="4" ALIGN="LEFT" BORDER="0" CELLPADDING="2"><FONT POINT-SIZE="13"><B>PERSON_AFFILIATIONS</B></FONT></TD></TR><TR><TD PORT="person_id" ALIGN="CENTER" BGCOLOR="#ffffff"><U>person_id</U></TD><TD PORT="affiliation_id" ALIGN="CENTER" BGCOLOR="#ffffff"><U>affiliation_id</U></TD><TD PORT="start_date" ALIGN="CENTER" BGCOLOR="#ffffff"><U>start_date</U></TD><TD PORT="end_date" ALIGN="CENTER" BGCOLOR="#ffffff">end_date</TD></TR></TABLE>>];
  "conferences" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="10" ALIGN="LEFT" BORDER="0" CELLPADDING="2"><FONT POINT-SIZE="13"><B>CONFERENCES</B></FONT></TD></TR><TR><TD PORT="conference_id" ALIGN="CENTER" BGCOLOR="#ffffff"><U>conference_id</U></TD><TD PORT="name" ALIGN="CENTER" BGCOLOR="#ffffff">name</TD><TD PORT="acronym" ALIGN="CENTER" BGCOLOR="#ffffff">acronym</TD><TD PORT="year" ALIGN="CENTER" BGCOLOR="#ffffff">year</TD><TD PORT="description" ALIGN="CENTER" BGCOLOR="#ffffff">description</TD><TD PORT="submission_open_at" ALIGN="CENTER" BGCOLOR="#ffffff">submission_open_at</TD><TD PORT="submission_close_at" ALIGN="CENTER" BGCOLOR="#ffffff">submission_close_at</TD><TD PORT="review_deadline" ALIGN="CENTER" BGCOLOR="#ffffff">review_deadline</TD><TD PORT="status" ALIGN="CENTER" BGCOLOR="#ffffff">status</TD><TD PORT="created_at" ALIGN="CENTER" BGCOLOR="#ffffff">created_at</TD></TR></TABLE>>];
  "conference_memberships" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="6" ALIGN="LEFT" BORDER="0" CELLPADDING="2"><FONT POINT-SIZE="13"><B>CONFERENCE_MEMBERSHIPS</B></FONT></TD></TR><TR><TD PORT="conference_id" ALIGN="CENTER" BGCOLOR="#ffffff"><U>conference_id</U></TD><TD PORT="person_id" ALIGN="CENTER" BGCOLOR="#ffffff"><U>person_id</U></TD><TD PORT="role" ALIGN="CENTER" BGCOLOR="#ffffff"><U>role</U></TD><TD PORT="membership_status" ALIGN="CENTER" BGCOLOR="#ffffff">membership_status</TD><TD PORT="joined_at" ALIGN="CENTER" BGCOLOR="#ffffff">joined_at</TD><TD PORT="max_active_assignments" ALIGN="CENTER" BGCOLOR="#ffffff">max_active_assignments</TD></TR></TABLE>>];
  "papers" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="9" ALIGN="LEFT" BORDER="0" CELLPADDING="2"><FONT POINT-SIZE="13"><B>PAPERS</B></FONT></TD></TR><TR><TD PORT="paper_id" ALIGN="CENTER" BGCOLOR="#ffffff"><U>paper_id</U></TD><TD PORT="conference_id" ALIGN="CENTER" BGCOLOR="#ffffff">conference_id</TD><TD PORT="title" ALIGN="CENTER" BGCOLOR="#ffffff">title</TD><TD PORT="abstract" ALIGN="CENTER" BGCOLOR="#ffffff">abstract</TD><TD PORT="submission_status" ALIGN="CENTER" BGCOLOR="#ffffff">submission_status</TD><TD PORT="submitted_at" ALIGN="CENTER" BGCOLOR="#ffffff">submitted_at</TD><TD PORT="created_by_person_id" ALIGN="CENTER" BGCOLOR="#ffffff">created_by_person_id</TD><TD PORT="updated_at" ALIGN="CENTER" BGCOLOR="#ffffff">updated_at</TD><TD PORT="search_vector" ALIGN="CENTER" BGCOLOR="#ffffff">search_vector</TD></TR></TABLE>>];
  "paper_authors" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="4" ALIGN="LEFT" BORDER="0" CELLPADDING="2"><FONT POINT-SIZE="13"><B>PAPER_AUTHORS</B></FONT></TD></TR><TR><TD PORT="paper_id" ALIGN="CENTER" BGCOLOR="#ffffff"><U>paper_id</U></TD><TD PORT="author_person_id" ALIGN="CENTER" BGCOLOR="#ffffff"><U>author_person_id</U></TD><TD PORT="author_order" ALIGN="CENTER" BGCOLOR="#ffffff">author_order</TD><TD PORT="is_corresponding" ALIGN="CENTER" BGCOLOR="#ffffff">is_corresponding</TD></TR></TABLE>>];
  "topics" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="3" ALIGN="LEFT" BORDER="0" CELLPADDING="2"><FONT POINT-SIZE="13"><B>TOPICS</B></FONT></TD></TR><TR><TD PORT="topic_id" ALIGN="CENTER" BGCOLOR="#ffffff"><U>topic_id</U></TD><TD PORT="topic_name" ALIGN="CENTER" BGCOLOR="#ffffff">topic_name</TD><TD PORT="description" ALIGN="CENTER" BGCOLOR="#ffffff">description</TD></TR></TABLE>>];
  "paper_topics" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="2" ALIGN="LEFT" BORDER="0" CELLPADDING="2"><FONT POINT-SIZE="13"><B>PAPER_TOPICS</B></FONT></TD></TR><TR><TD PORT="paper_id" ALIGN="CENTER" BGCOLOR="#ffffff"><U>paper_id</U></TD><TD PORT="topic_id" ALIGN="CENTER" BGCOLOR="#ffffff"><U>topic_id</U></TD></TR></TABLE>>];
  "reviewer_topics" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="4" ALIGN="LEFT" BORDER="0" CELLPADDING="2"><FONT POINT-SIZE="13"><B>REVIEWER_TOPICS</B></FONT></TD></TR><TR><TD PORT="reviewer_person_id" ALIGN="CENTER" BGCOLOR="#ffffff"><U>reviewer_person_id</U></TD><TD PORT="topic_id" ALIGN="CENTER" BGCOLOR="#ffffff"><U>topic_id</U></TD><TD PORT="expertise_level" ALIGN="CENTER" BGCOLOR="#ffffff">expertise_level</TD><TD PORT="declared_at" ALIGN="CENTER" BGCOLOR="#ffffff">declared_at</TD></TR></TABLE>>];
  "conflicts_of_interest" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="7" ALIGN="LEFT" BORDER="0" CELLPADDING="2"><FONT POINT-SIZE="13"><B>CONFLICTS_OF_INTEREST</B></FONT></TD></TR><TR><TD PORT="coi_id" ALIGN="CENTER" BGCOLOR="#ffffff"><U>coi_id</U></TD><TD PORT="paper_id" ALIGN="CENTER" BGCOLOR="#ffffff">paper_id</TD><TD PORT="reviewer_person_id" ALIGN="CENTER" BGCOLOR="#ffffff">reviewer_person_id</TD><TD PORT="coi_type" ALIGN="CENTER" BGCOLOR="#ffffff">coi_type</TD><TD PORT="detection_method" ALIGN="CENTER" BGCOLOR="#ffffff">detection_method</TD><TD PORT="detail" ALIGN="CENTER" BGCOLOR="#ffffff">detail</TD><TD PORT="detected_at" ALIGN="CENTER" BGCOLOR="#ffffff">detected_at</TD></TR></TABLE>>];
  "review_assignments" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="7" ALIGN="LEFT" BORDER="0" CELLPADDING="2"><FONT POINT-SIZE="13"><B>REVIEW_ASSIGNMENTS</B></FONT></TD></TR><TR><TD PORT="assignment_id" ALIGN="CENTER" BGCOLOR="#ffffff"><U>assignment_id</U></TD><TD PORT="paper_id" ALIGN="CENTER" BGCOLOR="#ffffff">paper_id</TD><TD PORT="reviewer_person_id" ALIGN="CENTER" BGCOLOR="#ffffff">reviewer_person_id</TD><TD PORT="assigned_by_person_id" ALIGN="CENTER" BGCOLOR="#ffffff">assigned_by_person_id</TD><TD PORT="assignment_status" ALIGN="CENTER" BGCOLOR="#ffffff">assignment_status</TD><TD PORT="assigned_at" ALIGN="CENTER" BGCOLOR="#ffffff">assigned_at</TD><TD PORT="due_at" ALIGN="CENTER" BGCOLOR="#ffffff">due_at</TD></TR></TABLE>>];
  "reviews" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="10" ALIGN="LEFT" BORDER="0" CELLPADDING="2"><FONT POINT-SIZE="13"><B>REVIEWS</B></FONT></TD></TR><TR><TD PORT="review_id" ALIGN="CENTER" BGCOLOR="#ffffff"><U>review_id</U></TD><TD PORT="assignment_id" ALIGN="CENTER" BGCOLOR="#ffffff">assignment_id</TD><TD PORT="overall_score" ALIGN="CENTER" BGCOLOR="#ffffff">overall_score</TD><TD PORT="confidence" ALIGN="CENTER" BGCOLOR="#ffffff">confidence</TD><TD PORT="recommendation" ALIGN="CENTER" BGCOLOR="#ffffff">recommendation</TD><TD PORT="comments_to_authors" ALIGN="CENTER" BGCOLOR="#ffffff">comments_to_authors</TD><TD PORT="comments_to_chair" ALIGN="CENTER" BGCOLOR="#ffffff">comments_to_chair</TD><TD PORT="review_status" ALIGN="CENTER" BGCOLOR="#ffffff">review_status</TD><TD PORT="submitted_at" ALIGN="CENTER" BGCOLOR="#ffffff">submitted_at</TD><TD PORT="updated_at" ALIGN="CENTER" BGCOLOR="#ffffff">updated_at</TD></TR></TABLE>>];
  "decisions" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="6" ALIGN="LEFT" BORDER="0" CELLPADDING="2"><FONT POINT-SIZE="13"><B>DECISIONS</B></FONT></TD></TR><TR><TD PORT="decision_id" ALIGN="CENTER" BGCOLOR="#ffffff"><U>decision_id</U></TD><TD PORT="paper_id" ALIGN="CENTER" BGCOLOR="#ffffff">paper_id</TD><TD PORT="decided_by_person_id" ALIGN="CENTER" BGCOLOR="#ffffff">decided_by_person_id</TD><TD PORT="outcome" ALIGN="CENTER" BGCOLOR="#ffffff">outcome</TD><TD PORT="rationale" ALIGN="CENTER" BGCOLOR="#ffffff">rationale</TD><TD PORT="decided_at" ALIGN="CENTER" BGCOLOR="#ffffff">decided_at</TD></TR></TABLE>>];
  "audit_log" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="8" ALIGN="LEFT" BORDER="0" CELLPADDING="2"><FONT POINT-SIZE="13"><B>AUDIT_LOG</B></FONT></TD></TR><TR><TD PORT="audit_id" ALIGN="CENTER" BGCOLOR="#ffffff"><U>audit_id</U></TD><TD PORT="table_name" ALIGN="CENTER" BGCOLOR="#ffffff">table_name</TD><TD PORT="operation" ALIGN="CENTER" BGCOLOR="#ffffff">operation</TD><TD PORT="record_pk" ALIGN="CENTER" BGCOLOR="#ffffff">record_pk</TD><TD PORT="actor_person_id" ALIGN="CENTER" BGCOLOR="#ffffff">actor_person_id</TD><TD PORT="old_data" ALIGN="CENTER" BGCOLOR="#ffffff">old_data</TD><TD PORT="new_data" ALIGN="CENTER" BGCOLOR="#ffffff">new_data</TD><TD PORT="occurred_at" ALIGN="CENTER" BGCOLOR="#ffffff">occurred_at</TD></TR></TABLE>>];
  "paper_embeddings" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="5" ALIGN="LEFT" BORDER="0" CELLPADDING="2"><FONT POINT-SIZE="13"><B>PAPER_EMBEDDINGS</B></FONT></TD></TR><TR><TD PORT="paper_id" ALIGN="CENTER" BGCOLOR="#ffffff"><U>paper_id</U></TD><TD PORT="embedding" ALIGN="CENTER" BGCOLOR="#ffffff">embedding</TD><TD PORT="model_name" ALIGN="CENTER" BGCOLOR="#ffffff">model_name</TD><TD PORT="content_hash" ALIGN="CENTER" BGCOLOR="#ffffff">content_hash</TD><TD PORT="embedded_at" ALIGN="CENTER" BGCOLOR="#ffffff">embedded_at</TD></TR></TABLE>>];
  "reviewer_embeddings" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="5" ALIGN="LEFT" BORDER="0" CELLPADDING="2"><FONT POINT-SIZE="13"><B>REVIEWER_EMBEDDINGS</B></FONT></TD></TR><TR><TD PORT="reviewer_person_id" ALIGN="CENTER" BGCOLOR="#ffffff"><U>reviewer_person_id</U></TD><TD PORT="embedding" ALIGN="CENTER" BGCOLOR="#ffffff">embedding</TD><TD PORT="model_name" ALIGN="CENTER" BGCOLOR="#ffffff">model_name</TD><TD PORT="content_hash" ALIGN="CENTER" BGCOLOR="#ffffff">content_hash</TD><TD PORT="embedded_at" ALIGN="CENTER" BGCOLOR="#ffffff">embedded_at</TD></TR></TABLE>>];
  "people" -> "user_accounts" [style=invis, weight=100];
  "user_accounts" -> "author_profiles" [style=invis, weight=100];
  "author_profiles" -> "reviewer_profiles" [style=invis, weight=100];
  "reviewer_profiles" -> "affiliations" [style=invis, weight=100];
  "affiliations" -> "person_affiliations" [style=invis, weight=100];
  "person_affiliations" -> "conferences" [style=invis, weight=100];
  "conferences" -> "conference_memberships" [style=invis, weight=100];
  "conference_memberships" -> "papers" [style=invis, weight=100];
  "papers" -> "paper_authors" [style=invis, weight=100];
  "paper_authors" -> "topics" [style=invis, weight=100];
  "topics" -> "paper_topics" [style=invis, weight=100];
  "paper_topics" -> "reviewer_topics" [style=invis, weight=100];
  "reviewer_topics" -> "conflicts_of_interest" [style=invis, weight=100];
  "conflicts_of_interest" -> "review_assignments" [style=invis, weight=100];
  "review_assignments" -> "reviews" [style=invis, weight=100];
  "reviews" -> "decisions" [style=invis, weight=100];
  "decisions" -> "audit_log" [style=invis, weight=100];
  "audit_log" -> "paper_embeddings" [style=invis, weight=100];
  "paper_embeddings" -> "reviewer_embeddings" [style=invis, weight=100];
  "people":"person_id":n -> "audit_log":"actor_person_id":s [dir=back, style=dashed, constraint=true];
  "people":"person_id":n -> "author_profiles":"person_id":s [dir=back, style=solid, constraint=true];
  "conferences":"conference_id":n -> "conference_memberships":"conference_id":s [dir=back, style=solid, constraint=true];
  "people":"person_id":n -> "conference_memberships":"person_id":s [dir=back, style=solid, constraint=true];
  "papers":"paper_id":n -> "conflicts_of_interest":"paper_id":s [dir=back, style=solid, constraint=true];
  "people":"person_id":n -> "conflicts_of_interest":"reviewer_person_id":s [dir=back, style=solid, constraint=true];
  "people":"person_id":n -> "decisions":"decided_by_person_id":s [dir=back, style=solid, constraint=true];
  "papers":"paper_id":n -> "decisions":"paper_id":s [dir=back, style=solid, constraint=true];
  "people":"person_id":n -> "paper_authors":"author_person_id":s [dir=back, style=solid, constraint=true];
  "papers":"paper_id":n -> "paper_authors":"paper_id":s [dir=back, style=solid, constraint=true];
  "papers":"paper_id":n -> "paper_embeddings":"paper_id":s [dir=back, style=solid, constraint=true];
  "papers":"paper_id":n -> "paper_topics":"paper_id":s [dir=back, style=solid, constraint=true];
  "topics":"topic_id":n -> "paper_topics":"topic_id":s [dir=back, style=solid, constraint=true];
  "conferences":"conference_id":n -> "papers":"conference_id":s [dir=back, style=solid, constraint=true];
  "people":"person_id":n -> "papers":"created_by_person_id":s [dir=back, style=solid, constraint=true];
  "affiliations":"affiliation_id":n -> "person_affiliations":"affiliation_id":s [dir=back, style=solid, constraint=true];
  "people":"person_id":n -> "person_affiliations":"person_id":s [dir=back, style=solid, constraint=true];
  "people":"person_id":n -> "review_assignments":"assigned_by_person_id":s [dir=back, style=dashed, constraint=true];
  "papers":"paper_id":n -> "review_assignments":"paper_id":s [dir=back, style=solid, constraint=true];
  "people":"person_id":n -> "review_assignments":"reviewer_person_id":s [dir=back, style=solid, constraint=true];
  "reviewer_profiles":"person_id":n -> "reviewer_embeddings":"reviewer_person_id":s [dir=back, style=solid, constraint=true];
  "people":"person_id":n -> "reviewer_profiles":"person_id":s [dir=back, style=solid, constraint=true];
  "reviewer_profiles":"person_id":n -> "reviewer_topics":"reviewer_person_id":s [dir=back, style=solid, constraint=true];
  "topics":"topic_id":n -> "reviewer_topics":"topic_id":s [dir=back, style=solid, constraint=true];
  "review_assignments":"assignment_id":n -> "reviews":"assignment_id":s [dir=back, style=solid, constraint=true];
  "people":"person_id":n -> "user_accounts":"person_id":s [dir=back, style=solid, constraint=true];
}
