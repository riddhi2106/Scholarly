graph scholarly_er {
  layout=neato; overlap=prism; overlap_scaling=-9; sep="+13";
  splines=true; esep="+6"; mode=major; maxiter=4000;
  graph [fontname="Helvetica", labelloc="t", fontsize=26,         label="Scholarly  -  Entity Relationship Diagram (Chen notation)\n "];
  node [fontname="Helvetica", color="#000000", penwidth=1.1];
  edge [fontname="Helvetica", fontsize=9, color="#000000",        penwidth=1.0];
  "PERSON" [shape=box, peripheries=1, label="PERSON", fontsize=13, style=filled, fillcolor="#e6e6e6", width=1.5, height=0.5];
  "USER_ACCOUNT" [shape=box, peripheries=1, label="USER_ACCOUNT", fontsize=13, style=filled, fillcolor="#e6e6e6", width=1.5, height=0.5];
  "AFFILIATION" [shape=box, peripheries=1, label="AFFILIATION", fontsize=13, style=filled, fillcolor="#e6e6e6", width=1.5, height=0.5];
  "CONFERENCE" [shape=box, peripheries=1, label="CONFERENCE", fontsize=13, style=filled, fillcolor="#e6e6e6", width=1.5, height=0.5];
  "PAPER" [shape=box, peripheries=1, label="PAPER", fontsize=13, style=filled, fillcolor="#e6e6e6", width=1.5, height=0.5];
  "TOPIC" [shape=box, peripheries=1, label="TOPIC", fontsize=13, style=filled, fillcolor="#e6e6e6", width=1.5, height=0.5];
  "ASSIGNMENT" [shape=box, peripheries=1, label="ASSIGNMENT", fontsize=13, style=filled, fillcolor="#e6e6e6", width=1.5, height=0.5];
  "REVIEW" [shape=box, peripheries=1, label="REVIEW", fontsize=13, style=filled, fillcolor="#e6e6e6", width=1.5, height=0.5];
  "DECISION" [shape=box, peripheries=1, label="DECISION", fontsize=13, style=filled, fillcolor="#e6e6e6", width=1.5, height=0.5];
  "AUDIT_ENTRY" [shape=box, peripheries=1, label="AUDIT_ENTRY", fontsize=13, style=filled, fillcolor="#e6e6e6", width=1.5, height=0.5];
  "AUTHOR" [shape=box, peripheries=1, label="AUTHOR", fontsize=13, style=filled, fillcolor="#e6e6e6", width=1.5, height=0.5];
  "REVIEWER" [shape=box, peripheries=1, label="REVIEWER", fontsize=13, style=filled, fillcolor="#e6e6e6", width=1.5, height=0.5];
  "PAPER_EMBEDDING" [shape=box, peripheries=2, label="PAPER_EMBEDDING", fontsize=13, style=filled, fillcolor="#e6e6e6", width=1.5, height=0.5];
  "REVIEWER_EMBEDDING" [shape=box, peripheries=2, label="REVIEWER_EMBEDDING", fontsize=13, style=filled, fillcolor="#e6e6e6", width=1.5, height=0.5];
  "PERSON__a0" [shape=ellipse, label=<<U>person_id</U>>, fontsize=9, style=filled, fillcolor="#ffffff", color="#000000", width=0.1, height=0.28, margin="0.04,0.02"];
  "PERSON" -- "PERSON__a0" [len=0.9, color="#000000"];

  "PERSON__a1" [shape=ellipse, label="full_name", fontsize=9, style=filled, fillcolor="#ffffff", color="#000000", width=0.1, height=0.28, margin="0.04,0.02"];
  "PERSON" -- "PERSON__a1" [len=0.9, color="#000000"];

  "PERSON__a2" [shape=ellipse, label="email", fontsize=9, style=filled, fillcolor="#ffffff", color="#000000", width=0.1, height=0.28, margin="0.04,0.02"];
  "PERSON" -- "PERSON__a2" [len=0.9, color="#000000"];

  "PERSON__a3" [shape=ellipse, label="created_at", fontsize=9, style=filled, fillcolor="#ffffff", color="#000000", width=0.1, height=0.28, margin="0.04,0.02"];
  "PERSON" -- "PERSON__a3" [len=0.9, color="#000000"];

  "USER_ACCOUNT__a0" [shape=ellipse, label=<<U>account_id</U>>, fontsize=9, style=filled, fillcolor="#ffffff", color="#000000", width=0.1, height=0.28, margin="0.04,0.02"];
  "USER_ACCOUNT" -- "USER_ACCOUNT__a0" [len=0.9, color="#000000"];

