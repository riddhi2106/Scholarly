  "CONFERENCE" -- "CONFERENCE__a4" [len=0.9, color="#000000"];

  "CONFERENCE__a5" [shape=ellipse, label="submission_open_at", fontsize=9, style=filled, fillcolor="#ffffff", color="#000000", width=0.1, height=0.28, margin="0.04,0.02"];
