  "USER_ACCOUNT" -- "USER_ACCOUNT__a1" [len=0.9, color="#000000"];

  "USER_ACCOUNT__a2" [shape=ellipse, label="system_role", fontsize=9, style=filled, fillcolor="#ffffff", color="#000000", width=0.1, height=0.28, margin="0.04,0.02"];
