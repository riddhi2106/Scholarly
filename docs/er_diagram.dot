  "AFFILIATION" -- "AFFILIATION__a3" [len=0.9, color="#000000"];

  "CONFERENCE__a0" [shape=ellipse, label=<<U>conference_id</U>>, fontsize=9, style=filled, fillcolor="#ffffff", color="#000000", width=0.1, height=0.28, margin="0.04,0.02"];
