%%{init: {'theme':'neutral'}}%%
---
title: Scholarly - Full Entity Relationship Diagram
---
erDiagram
    PEOPLE {
        bigint person_id PK "NOT NULL"
        character_varying_200 full_name "NOT NULL"
        citext email UK "NOT NULL"
        timestamp_with_time_zone created_at "NOT NULL"
    }
    USER_ACCOUNTS {
        bigint account_id PK "NOT NULL"
        bigint person_id FK,UK "NOT NULL"
        text password_hash "NOT NULL"
        character_varying_10 system_role "NOT NULL"
        character_varying_20 account_status "NOT NULL"
        timestamp_with_time_zone created_at "NOT NULL"
        timestamp_with_time_zone last_login_at
    }
    AUTHOR_PROFILES {
        bigint person_id PK,FK "NOT NULL"
        character_varying_20 profile_status "NOT NULL"
    }
    REVIEWER_PROFILES {
        bigint person_id PK,FK "NOT NULL"
        text bio
        text research_keywords
        character_varying_20 reviewer_status "NOT NULL"
        timestamp_with_time_zone created_at "NOT NULL"
    }
    AFFILIATIONS {
        bigint affiliation_id PK "NOT NULL"
        character_varying_250 institution_name "NOT NULL"
        character_varying_150 institution_domain
        character_2 country_code
    }
    PERSON_AFFILIATIONS {
        bigint person_id PK,FK "NOT NULL"
        bigint affiliation_id PK,FK "NOT NULL"
        date start_date PK "NOT NULL"
        date end_date
    }
    CONFERENCES {
        bigint conference_id PK "NOT NULL"
        character_varying_200 name "NOT NULL"
        character_varying_20 acronym "NOT NULL"
        smallint year "NOT NULL"
        text description
        timestamp_with_time_zone submission_open_at "NOT NULL"
        timestamp_with_time_zone submission_close_at "NOT NULL"
        timestamp_with_time_zone review_deadline "NOT NULL"
        character_varying_20 status "NOT NULL"
        timestamp_with_time_zone created_at "NOT NULL"
    }
    CONFERENCE_MEMBERSHIPS {
        bigint conference_id PK,FK "NOT NULL"
        bigint person_id PK,FK "NOT NULL"
        character_varying_20 role PK "NOT NULL"
        character_varying_20 membership_status "NOT NULL"
        timestamp_with_time_zone joined_at "NOT NULL"
        integer max_active_assignments
    }
    PAPERS {
        bigint paper_id PK "NOT NULL"
        bigint conference_id FK "NOT NULL"
        character_varying_300 title "NOT NULL"
        text abstract "NOT NULL"
        character_varying_20 submission_status "NOT NULL"
        timestamp_with_time_zone submitted_at "NOT NULL"
        bigint created_by_person_id FK "NOT NULL"
        timestamp_with_time_zone updated_at "NOT NULL"
        tsvector search_vector
    }
    PAPER_AUTHORS {
        bigint paper_id PK,FK "NOT NULL"
        bigint author_person_id PK,FK "NOT NULL"
        smallint author_order "NOT NULL"
        boolean is_corresponding "NOT NULL"
    }
    TOPICS {
        bigint topic_id PK "NOT NULL"
        character_varying_100 topic_name UK "NOT NULL"
        text description
    }
    PAPER_TOPICS {
        bigint paper_id PK,FK "NOT NULL"
        bigint topic_id PK,FK "NOT NULL"
    }
    REVIEWER_TOPICS {
        bigint reviewer_person_id PK,FK "NOT NULL"
        bigint topic_id PK,FK "NOT NULL"
        smallint expertise_level "NOT NULL"
        timestamp_with_time_zone declared_at "NOT NULL"
    }
    CONFLICTS_OF_INTEREST {
        bigint coi_id PK "NOT NULL"
        bigint paper_id FK "NOT NULL"
        bigint reviewer_person_id FK "NOT NULL"
        character_varying_30 coi_type "NOT NULL"
        character_varying_10 detection_method "NOT NULL"
        text detail
        timestamp_with_time_zone detected_at "NOT NULL"
    }
    REVIEW_ASSIGNMENTS {
        bigint assignment_id PK "NOT NULL"
        bigint paper_id FK "NOT NULL"
        bigint reviewer_person_id FK "NOT NULL"
        bigint assigned_by_person_id FK
        character_varying_20 assignment_status "NOT NULL"
        timestamp_with_time_zone assigned_at "NOT NULL"
        timestamp_with_time_zone due_at
    }
    REVIEWS {
        bigint review_id PK "NOT NULL"
        bigint assignment_id FK,UK "NOT NULL"
        smallint overall_score "NOT NULL"
        smallint confidence "NOT NULL"
        character_varying_20 recommendation "NOT NULL"
        text comments_to_authors "NOT NULL"
        text comments_to_chair
        character_varying_20 review_status "NOT NULL"
        timestamp_with_time_zone submitted_at "NOT NULL"
        timestamp_with_time_zone updated_at "NOT NULL"
    }
    DECISIONS {
        bigint decision_id PK "NOT NULL"
        bigint paper_id FK,UK "NOT NULL"
        bigint decided_by_person_id FK "NOT NULL"
        character_varying_20 outcome "NOT NULL"
        text rationale
        timestamp_with_time_zone decided_at "NOT NULL"
    }
    AUDIT_LOG {
        bigint audit_id PK "NOT NULL"
        character_varying_60 table_name "NOT NULL"
        character_varying_10 operation "NOT NULL"
        text record_pk "NOT NULL"
        bigint actor_person_id FK
        jsonb old_data
        jsonb new_data
        timestamp_with_time_zone occurred_at "NOT NULL"
    }
    PAPER_EMBEDDINGS {
        bigint paper_id PK,FK "NOT NULL"
        vector_384 embedding "NOT NULL"
        character_varying_120 model_name "NOT NULL"
        character_64 content_hash
        timestamp_with_time_zone embedded_at "NOT NULL"
    }
    REVIEWER_EMBEDDINGS {
        bigint reviewer_person_id PK,FK "NOT NULL"
        vector_384 embedding "NOT NULL"
        character_varying_120 model_name "NOT NULL"
        character_64 content_hash
        timestamp_with_time_zone embedded_at "NOT NULL"
    }
    PEOPLE |o--o{ AUDIT_LOG : "acted as"
    PEOPLE ||--o| AUTHOR_PROFILES : "is an author"
    CONFERENCES ||--o{ CONFERENCE_MEMBERSHIPS : "has committee"
    PEOPLE ||--o{ CONFERENCE_MEMBERSHIPS : "serves on"
    PAPERS ||--o{ CONFLICTS_OF_INTEREST : "has conflict"
    PEOPLE ||--o{ CONFLICTS_OF_INTEREST : "conflicted on"
    PEOPLE ||--o{ DECISIONS : "decides"
    PAPERS ||--o| DECISIONS : "receives verdict"
    PEOPLE ||--o{ PAPER_AUTHORS : "authors"
    PAPERS ||--o{ PAPER_AUTHORS : "written by"
    PAPERS ||--o| PAPER_EMBEDDINGS : "embedded as"
    PAPERS ||--o{ PAPER_TOPICS : "tagged with"
    TOPICS ||--o{ PAPER_TOPICS : "categorises"
    CONFERENCES ||--o{ PAPERS : "receives"
    PEOPLE ||--o{ PAPERS : "submits"
    AFFILIATIONS ||--o{ PERSON_AFFILIATIONS : "employs"
    PEOPLE ||--o{ PERSON_AFFILIATIONS : "affiliated with"
    PEOPLE |o--o{ REVIEW_ASSIGNMENTS : "allocated by"
    PAPERS ||--o{ REVIEW_ASSIGNMENTS : "assigned for review"
    PEOPLE ||--o{ REVIEW_ASSIGNMENTS : "reviews"
    REVIEWER_PROFILES ||--o| REVIEWER_EMBEDDINGS : "embedded as"
    PEOPLE ||--o| REVIEWER_PROFILES : "is a reviewer"
    REVIEWER_PROFILES ||--o{ REVIEWER_TOPICS : "declares expertise in"
    TOPICS ||--o{ REVIEWER_TOPICS : "claimed by"
    REVIEW_ASSIGNMENTS ||--o| REVIEWS : "produces"
    PEOPLE ||--o| USER_ACCOUNTS : "signs in as"
